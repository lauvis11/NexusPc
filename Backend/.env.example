# ===================================================
# NEXUSPC BACKEND - VARIABLES DE ENTORNO DE EJEMPLO
# Copiar este archivo como .env y completar los valores
# ===================================================

# URL del Frontend (para configurar CORS y redirecciones)
FRONTEND_URL=http://localhost:3000

# Conexión a la base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db?sslmode=require

# Entorno de ejecución (development | production)
NODE_ENV=development

# Claves secretas para firma y verificación de JWT (generar claves seguras)
SECRET_KEY=clave_secreta_jwt_para_access_token
REFRESH_KEY=clave_secreta_jwt_para_refresh_token

# Cloudinary (almacenamiento de imágenes de productos)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Mercado Pago (Credenciales de integración - test o producción)
MP_ACCESS_TOKEN=tu_access_token_de_mercadopago

# Webhooks de Mercado Pago para notificaciones de pago
WEBHOOK_URL=https://tu-dominio.com/webhooks/mercadopago
WEBHOOK_SECRET=tu_webhook_secret_de_mercadopago
