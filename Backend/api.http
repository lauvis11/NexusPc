### Para ver todos los productos
GET http://localhost:3000/productos

### Para filtrar productos por categoria
GET http://localhost:3000/productos?categoria=Placas de Video

### Para ver un producto por su id
GET http://localhost:3000/productos/3e27aaeb-a7ca-417b-bc63-562f772e3406

### Para crear un producto
POST http://localhost:3000/productos
Content-Type: application/json

{
    "nombre": "RTX 4070 Ti Super",
    "descripcion": "Tarjeta gráfica NVIDIA RTX 4070 Ti Super 16GB GDDR6X",
    "precio": 850.00,
    "stock": 10,
    "img_url": "https://fakestoreapi.com/img/81fAn9+IfdL._AC_UY879_.jpg",
    "public_id": "temp",
    "categoria_id": 1,
    "caracteristicas": [
        { "clave": "VRAM", "valor": "16GB" },
        { "clave": "Memoria", "valor": "GDDR6X" },
        { "clave": "Bus", "valor": "256-bit" }
    ]
}

### Para editar un producto
PATCH http://localhost:3000/productos/3e27aaeb-a7ca-417b-bc63-562f772e3406
Content-Type: application/json

{
    "precio": 900.00,
    "stock": 6
}

### Para eliminar un producto
DELETE http://localhost:3000/productos/3e27aaeb-a7ca-417b-bc63-562f772e3406

### Para ver todas las categorias
GET http://localhost:3000/categorias

### Para crear una categoria
POST http://localhost:3000/categorias
Content-Type: application/json

{
    "nombre": "Mandos"    
}

### Para eliminar una categoria
DELETE http://localhost:3000/categorias/13

### Para registrarse
POST http://localhost:3000/auth/register
Content-Type: application/json

{
    "nombre": "Gabriel",
    "email": "gabriel@gmail.com",
    "password": "12345678"
}

### Para iniciar Sesion
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "email": "gabriel@gmail.com",
    "password": "12345678"
}

### Para cerrar sesion
POST http://localhost:3000/auth/logout